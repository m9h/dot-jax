% ============================================================================
\section{Methods}
% ============================================================================

\subsection{Photon diffusion forward model}

Continuous-wave photon transport in tissue is modelled by the
steady-state diffusion equation~\citep{Ishimaru1978wave,
Patterson1989time}:
%
\begin{equation}\label{eq:diffusion}
  -\nabla \cdot \bigl(D\,\nabla\Phi\bigr) + \mu_a\,\Phi = S
\end{equation}
%
where $\Phi(\mathbf{r})$ is the photon fluence rate, $D =
1/[3(\mu_a + \mu_s')]$ is the diffusion coefficient, $\mu_a$ is the
absorption coefficient, $\mu_s'$ is the reduced scattering
coefficient, and $S$ is the source term. The Robin (type~III) boundary
condition~\citep{Haskell1994boundary} at the tissue--air interface is:
%
\begin{equation}
  \Phi + 2A\,D\,\frac{\partial\Phi}{\partial\hat{n}} = 0
  \qquad\text{where}\quad
  A = \frac{1 + R_{\text{eff}}}{1 - R_{\text{eff}}}
\end{equation}
%
and $R_{\text{eff}}$ is the effective Fresnel reflection coefficient
computed via numerical integration over all angles of incidence.

\subsection{Finite element discretisation}

Following~\citet{Arridge1993fem} and~\citet{Schweiger1993fem}, we
discretise~\eqref{eq:diffusion} with linear tetrahedral elements on
an atlas head mesh. The FEM system is:
%
\begin{equation}
  \underbrace{(\mathbf{K} + \mathbf{M} + \mathbf{C})}_{\mathbf{A}}
  \,\boldsymbol{\Phi} = \mathbf{b}
\end{equation}
%
with stiffness $K_{ij} = \sum_e D_e \int_{\Omega_e} \nabla\phi_i
\cdot\nabla\phi_j\,dV$, consistent mass $M_{ij} = \sum_e \mu_{a,e}
\int_{\Omega_e} \phi_i\,\phi_j\,dV$, and Robin boundary $C_{ij} =
\frac{1}{2A}\int_{\Gamma} \phi_i\,\phi_j\,dS$. The gradient
products $\nabla\phi_i \cdot \nabla\phi_j$ are precomputed per
element via the deldotdel operator, cross-validated against
redbirdpy.

\subsection{Atlas-based head mesh}

We generate a standard-space head mesh from the MNI152 ICBM 2009c
atlas via:
\begin{enumerate}
  \item Tissue probability maps (CSF, GM, WM at \SI{1}{\milli\metre})
        fetched via nilearn
  \item Brain mask extraction by thresholding
  \item Marching cubes surface extraction (scikit-image)
  \item Interior point sampling and Delaunay tetrahedralisation (scipy)
  \item Element pruning (remove exterior/degenerate elements)
  \item FEMMesh construction with precomputed operators
\end{enumerate}
Optode positions (in Talairach/MNI coordinates from the SNIRF file)
are projected to the mesh surface via nearest-neighbour lookup.

\subsection{Signal processing pipeline}

The raw CW intensity data undergo the following preprocessing:

\paragraph{Channel quality control.}
Channels are pruned based on three criteria: signal-to-noise ratio
($\text{SNR} = \bar{I}/\sigma_I < 2$ rejected), coefficient of
variation ($\text{CV} = \sigma_I/\bar{I} > 0.5$ rejected), and
saturation (fraction of samples at rail $> 0.999$ rejected).

\paragraph{Optical density conversion.}
Raw intensity is converted to optical density change:
$\Delta\text{OD}(t) = -\ln\bigl(I(t)/\bar{I}\bigr)$.

\paragraph{Motion artifact correction.}
Spike artifacts are detected where $|dI/dt| > 5\sigma$ and corrected
via cubic spline interpolation through clean segments.

\paragraph{Short-separation regression.}
Channels with source--detector distance $< \SI{10}{\milli\metre}$
are used as regressors for superficial
physiology~\citep{Saager2005short, Brigadoi2015short}. A GLM with
the mean short-channel signal as regressor is applied to each long
channel.

\paragraph{Bandpass filtering and downsampling.}
A 5th-order Butterworth bandpass (\SIrange{0.01}{0.5}{\hertz}) removes
physiological noise and drift. Block averaging downsamples from
10\,Hz to 1\,Hz.

\subsection{Image reconstruction}

\paragraph{Sensitivity matrix.}
The absorption Jacobian is computed via the adjoint
method~\citep{Arridge1999inverse} with Rytov normalisation:
%
\begin{equation}
  J_{c,n} = \frac{-\Phi_s(n)\,\Phi_d(n)\,V_n}
                  {|\mathbf{R}_d^\top\boldsymbol{\Phi}_s|}
\end{equation}
%
where $c$ indexes the source--detector channel, $n$ the mesh node,
$\Phi_s$ and $\Phi_d$ are the forward and adjoint Green's functions,
and $V_n$ is the nodal volume. Channels with source--detector
distance outside \SIrange{10}{55}{\milli\metre} are excluded.

\paragraph{Regularisation.}
The regularisation parameter $\lambda$ is selected by minimising
the Generalised Cross-Validation (GCV) criterion:
%
\begin{equation}
  \text{GCV}(\lambda) = \frac{\|\mathbf{J}\hat{\mathbf{x}} - \mathbf{d}\|^2/m}
                              {\bigl(\text{tr}(\mathbf{I} - \mathbf{H}_\lambda)/m\bigr)^2}
\end{equation}
%
where $\mathbf{H}_\lambda = \mathbf{J}(\mathbf{J}^\top\mathbf{J} +
\lambda\mathbf{I})^{-1}\mathbf{J}^\top$ and $m$ is the number of
measurements. An L-curve corner detection method is also available.

\paragraph{Tikhonov inversion.}
Per-timepoint reconstruction: $\Delta\hat{\mu}_a =
(\mathbf{J}^\top\mathbf{J} + \lambda\mathbf{I})^{-1}\mathbf{J}^\top
\Delta\text{OD}$.

\subsection{Spectral unmixing}

Absorption changes at two wavelengths are decomposed into chromophore
concentration changes via the pseudoinverse of the extinction matrix:
%
\begin{equation}
  \begin{pmatrix} \Delta[\text{HbO}_2] \\ \Delta[\text{Hb}] \end{pmatrix}
  = \mathbf{E}^+ \begin{pmatrix} \Delta\mu_a(\lambda_1) \\
  \Delta\mu_a(\lambda_2) \end{pmatrix}
\end{equation}
%
where $\mathbf{E}$ contains molar extinction coefficients from the
Prahl/OMLC tables~\citep{Prahl1999omlc} interpolated to 750 and
\SI{850}{\nano\metre}.

\subsection{Spatial smoothing and normalisation}

Reconstructed images are spatially smoothed with a Gaussian kernel
($\text{FWHM} = \SI{13}{\milli\metre}$) applied on the mesh nodes,
matching the published NIfTI kernel. Time series are z-scored per
node for scale-invariant comparison.

% ============================================================================
\section{Results}
% ============================================================================

\subsection{Cross-validation against redbirdpy}

<<validation-table, engine="python", results="asis">>=
# Summary of test suite validation
modules = [
    ("analytical", 32, "Bessel, harmonics, fluence, reflection"),
    ("property", 34, "Extinction, Beer-Lambert, scattering"),
    ("mesh", 37, "Volumes, areas, deldotdel, surface extraction"),
    ("assembly", 33, "K, M, C matrices vs.\\ redbirdpy"),
    ("forward", 25, "Source location, adjoint, dense/sparse"),
    ("spectral", 10, "Multi-wavelength, Jacobian"),
    ("recon", 13, "L-curve, GCV, Gauss-Newton"),
    ("hemodynamics", 45, "OD, motion, pruning, regression, GVTD"),
    ("io", 25, "SNIRF, BIDS-fNIRS, ds004569"),
    ("atlas", 12, "MNI152 mesh, optode projection"),
    ("types", 6, "Constants, containers"),
]

print(r"\begin{table}[h]")
print(r"\centering")
print(r"\caption{dot-jax test suite: 272 tests across 11 modules.}")
print(r"\label{tab:tests}")
print(r"\begin{tabular}{lrl}")
print(r"\toprule")
print(r"Module & Tests & Validation scope \\")
print(r"\midrule")
for mod, n, desc in modules:
    print(f"\\texttt{{{mod}}} & {n} & {desc} \\\\")
print(r"\midrule")
print(f"\\textbf{{Total}} & \\textbf{{{sum(n for _,n,_ in modules)}}} & \\\\")
print(r"\bottomrule")
print(r"\end{tabular}")
print(r"\end{table}")
@

All assembly, analytical, and property functions are cross-validated
against redbirdpy to relative tolerance $10^{-10}$, confirming
numerical equivalence of the JAX reimplementation. The system matrix
$\mathbf{A}$ matches redbirdpy's \texttt{femlhs} output to machine
precision on the test mesh.

